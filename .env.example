# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key-here

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Alpaca Paper Trading — https://alpaca.markets (free paper account)
# Set ALPACA_BASE_URL to paper endpoint for paper mode, live endpoint for live mode
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_API_SECRET=your-alpaca-api-secret-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Kraken (optional) — https://www.kraken.com/settings/api
KRAKEN_API_KEY=your-kraken-api-key-here
KRAKEN_API_SECRET=your-kraken-api-secret-here

# Trading safety gate — NEVER set to true until paper tests pass and legal review complete
LIVE_TRADING_ENABLED=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
