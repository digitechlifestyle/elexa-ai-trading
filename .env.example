# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Alpaca Paper Trading — https://alpaca.markets (free paper account)
# Set ALPACA_BASE_URL to paper endpoint for paper mode, live endpoint for live mode
ALPACA_API_KEY=your-alpaca-paper-key
ALPACA_API_SECRET=your-alpaca-paper-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading safety gate — NEVER set to true until paper tests pass and legal review complete
LIVE_TRADING_ENABLED=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
