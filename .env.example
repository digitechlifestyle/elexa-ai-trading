# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key-here

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Alpaca Paper Trading — https://alpaca.markets (free paper account)
# Set ALPACA_BASE_URL to paper endpoint for paper mode, live endpoint for live mode
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_API_SECRET=your-alpaca-api-secret-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Kraken (optional) — https://www.kraken.com/settings/api
KRAKEN_API_KEY=your-kraken-api-key-here
KRAKEN_API_SECRET=your-kraken-api-secret-here

# FRED (Federal Reserve Economic Data) — free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Powers the Buffett Indicator (/api/buffett) and the Quant Agent's real
# market-data context. Without this, both silently report "unavailable"
# instead of erroring — check /api/buffett returns real numbers, not a 503.
FRED_API_KEY=your-fred-api-key-here

# Trading safety gate — NEVER set to true until paper tests pass and legal review complete.
# This is the platform-wide kill switch for /api/trading/live. Even when true,
# a route still requires the user to have connected their own live Alpaca
# account and accepted the current risk disclaimer — see LAUNCH-CHECKLIST.md
# for the full pre-launch gate (lawyer review, KYC/AML path, paper track record).
LIVE_TRADING_ENABLED=false

# Encrypts user-supplied live broker API keys at rest (broker_connections
# table). Generate with: openssl rand -base64 32
# Rotating this key invalidates every stored broker connection — users would
# need to reconnect. Keep it out of git, back it up somewhere durable.
BROKER_CREDENTIALS_ENCRYPTION_KEY=

# /admin/setup bootstrap tool — leave unset/false. Only set to true
# temporarily while creating your first admin account, then unset it.
# Leaving it on means anyone who ever obtains SUPABASE_SERVICE_ROLE_KEY can
# create or take over any account through this endpoint.
ADMIN_SETUP_ENABLED=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
